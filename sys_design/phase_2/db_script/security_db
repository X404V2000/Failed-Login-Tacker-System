CREATE DATABASE security_db;

CREATE TABLE users(
	id INT AUTO_INCREMENT PRIMARY KEY,
	username VARCHAR(50) UNIQUE NOT NULL,
	email VARCHAR(100) UNIQUE,
	password_hash VARCHAR(255) NOT NULL,
	salt VARCHAR(50),
	created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
	last_login TIMESTAMP NULL DEFAULT NULL,
	is_active BOOLEAN DEFAULT TRUE,
	is_locked BOOLEAN DEFAULT FALSE
) ENGINE=innoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE security_db.login_attempts(
	id INT AUTO_INCREMENT PRIMARY KEY,
	user_id INT NOT NULL,
	ip_address VARCHAR(45) NOT NULL,
	timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
	status ENUM('SUCCESS', 'FAILED', 'BLOCKED', 'UNKNOWN') NOT NULL DEFAULT 'UNKNOWN',
	password_attemp VARCHAR(100),
	user_agent VARCHAR(255),
	country VARCHAR(50));

CREATE TABLE security_db.blocked_ips(
	id INT AUTO_INCREMENT PRIMARY KEY,
	ip_address VARCHAR(45) UNIQUE NOT NULL,
	reason TEXT,
	blocked_by VARCHAR(50),
	blocked_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
	expires_at TIMESTAMP NULL,
	is_permanent BOOLEAN DEFAULT FALSE);

CREATE TABLE security_db.threats(
	id INT AUTO_INCREMENT PRIMARY KEY,
	ip_address VARCHAR(45),
	threat_type VARCHAR(50) NOT NULL,
	severity ENUM('LOW', 'MEDIUM', 'HIGH', 'CRITICAL') NOT NULL DEFAULT 'MEDIUM',
	description TEXT,
	detected_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
	resolved BOOLEAN DEFAULT FALSE);
	
CREATE TABLE security_db.audit_logs(
	id INT AUTO_INCREMENT PRIMARY KEY,
	user_id INT,
	action VARCHAR(100),
	details JSON,
	timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
	ip_address VARCHAR(45));
